# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
# 저장소가 public 이라 .env 계열은 전부 막는다. 키를 넣는 순간 전 세계에 공개된다.
# ⚠️ 파생 파일(.env.local.bak 등)까지 막으려고 와일드카드로 둔다 — 2026-08-30 에 실제로
#    그런 백업 파일이 생겼다가 gitignore 밖이라는 걸 발견했다.
.env*
# .env.production 은 이미 추적 중이라 예외로 둔다(내용은 DISABLE_ESLINT_PLUGIN=true 뿐).
# gitignore 는 이미 tracked 인 파일에 영향을 주지 않으므로, 이 줄은 "의도적으로 남긴 것" 표시다.
!.env.production

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel

# 병렬 세션 작업용 git worktree 폴더 (작업 사본 — 커밋 금지)
/.worktrees/

# 업무지시서 / 케이스 데이터 (로컬 작업용)
/신규등록_업무지시.txt
/신규등록_업무지시서.xlsx
/신규등록_케이스전체_168건.txt

# 재무/파이프라인 로컬 작업 폴더 (기업 민감 데이터 — 커밋 금지)
/재무비율_자동계산_작업/
/파이프라인_기관연동_작업/

# 보안 사고 대응 기록 (미조치 취약점 위치가 적혀 있음 — 공개 저장소 커밋 금지)
/보안사고_대응_2026-07-27/

# 배정DB 동기화 설정용 로컬 폴더 (공유 비밀키가 들어 있음 — 공개 저장소 커밋 금지)
/배정DB_설정_로컬/

# superpowers 작업공간(스크래치) — 커밋하지 않는다
.superpowers/
